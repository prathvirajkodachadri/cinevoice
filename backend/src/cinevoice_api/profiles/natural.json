{
  "schema_version": 1,
  "name": "Natural Voice Cleanup",
  "description": "Gentle cleanup that preserves the original vocal tone.",
  "target_lufs": -16.0,
  "true_peak_ceiling_dbtp": -1.0,
  "ai_denoise": {"mode": "auto", "compensate_delay": true, "post_filter": false},
  "high_pass": {"enabled": true, "frequency_hz": 50.0, "order": 4},
  "eq_bands": [
    {"type": "bell", "frequency_hz": 360.0, "gain_db": -1.2, "q": 0.8, "reason": "Gentle low-mid cleanup"},
    {"type": "bell", "frequency_hz": 3000.0, "gain_db": 0.8, "q": 0.7, "reason": "Natural intelligibility"}
  ],
  "compressor": {"enabled": true, "ratio": 2.0, "attack_ms": 30.0, "release_ms": 150.0, "knee_db": 8.0, "target_gain_reduction_db": 2.0, "makeup_gain_db": 1.5},
  "saturation": {"enabled": true, "drive_db": 0.5, "mix": 0.05},
  "deesser": {"enabled": true, "crossover_hz": 5800.0, "attack_ms": 2.0, "release_ms": 100.0, "target_gain_reduction_db": 1.2, "maximum_gain_reduction_db": 2.0},
  "limiter": {"enabled": true, "lookahead_ms": 5.0, "release_ms": 150.0, "maximum_recommended_reduction_db": 2.0},
  "formant": {"enabled": false, "reason": "Speaker identity preservation"}
}
